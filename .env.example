# Public URL used when generating share links (no trailing slash)
ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Server
PORT=5173
HOST=0.0.0.0

# Maximum request body SvelteKit will accept (default is only 512K).
# Must be larger than your biggest upload / GIF job.
BODY_SIZE_LIMIT=256M

# Where uploads and the SQLite database live (relative to the project root)
DATA_DIR=data

# Secret used for session signing / share cookies. Generated automatically if omitted.
AUTH_SECRET=

# Uploads require a signed-in account. API keys and the Discord bot authenticate
# as a user, so automation does not need anonymous access.

# Initial administrator account (created on first boot when the database is empty)
ADMIN_EMAIL=admin@nimbus.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nimbus1234

# Discord bot (can also be configured from /dashboard/admin -> Discord)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Optional override for the bot API secret (normally managed from the admin dashboard)
BOT_SECRET=
